---
import Default from '@astrojs/starlight/components/SiteTitle.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
---

<div class="site-title-group">
  {
    hasSidebar && (
      <button
        type="button"
        class="sidebar-toggle"
        aria-controls="starlight__sidebar"
        aria-expanded="true"
        aria-label="Toggle sidebar"
        title="Toggle sidebar"
      >
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <rect x="3" y="4" width="18" height="16" rx="2" fill="none" stroke="currentColor" stroke-width="1.75" />
          <line x1="9" y1="4" x2="9" y2="20" stroke="currentColor" stroke-width="1.75" />
        </svg>
      </button>
    )
  }
  <Default />
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>('.sidebar-toggle');
  if (button) {
    const root = document.documentElement;
    const sync = () =>
      button.setAttribute('aria-expanded', String(!root.hasAttribute('data-sidebar-collapsed')));
    sync();
    button.addEventListener('click', () => {
      const collapsed = root.toggleAttribute('data-sidebar-collapsed');
      try {
        localStorage.setItem('sl-sidebar-collapsed', String(collapsed));
      } catch {}
      sync();
    });
  }
</script>

<style>
  .site-title-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .sidebar-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.375rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }

  .sidebar-toggle:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }

  @media (min-width: 50rem) {
    .sidebar-toggle {
      display: inline-flex;
    }
  }
</style>
